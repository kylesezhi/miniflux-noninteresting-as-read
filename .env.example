MINIFLUX_URL=
MINIFLUX_API_TOKEN=
OPENROUTER_API_KEY=
OPENCODEGO_API_KEY=
OPENCODEGO_MODEL=deepseek-v4-flash
# Optional: pin the Opencode Go session ID across runs for prompt caching.
# Leave empty for a fresh session per run.
#OPENCODEGO_SESSION_ID=
LLM_PROVIDER=opencodego
CLASSIFICATION_DELAY_SECONDS=2

# Web log viewer (optional; these are the defaults)
#WEB_HOST=0.0.0.0
#WEB_PORT=5000
#WEB_LOG_PATH=logs/classifier.jsonl
